    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "nova5_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "Link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "Link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
