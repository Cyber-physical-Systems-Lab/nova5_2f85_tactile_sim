#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "nova5_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmptsd0pbj3/nova5_robot.usdc


